# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXARIS B2B Production Configuration:
# Verified WhatsApp Business Number (+919824618484)
VITE_WHATSAPP_NUMBER="919824618484"

# Official Verified Business Email (contact@nexaris.co.in)
VITE_BUSINESS_EMAIL="contact@nexaris.co.in"

# Official Trade Desk Phone (+91 98246 18484)
VITE_OFFICIAL_PHONE="+91 98246 18484"

# Business Location: Gandhinagar, Gujarat, India

# Production Enquiry Dispatch Endpoint (e.g. https://api.nexaris.co.in/v1/enquiries or CRM webhook)
VITE_ENQUIRY_API_ENDPOINT="/api/enquiries"

# NEXARIS Owner CRM Private Authentication:
# Configured owner email (defaults to official tiwariabhi1211@gmail.com)
CRM_OWNER_EMAIL="tiwariabhi1211@gmail.com"

# Initial setup password (must be changed upon first login in CRM Settings)
